# CivicSim backend. Copy to .env and fill in; .env is gitignored.
# Start the API with: uv run --env-file .env uvicorn main:app --port 8000

# OpenAI key for Ask CivicSim (POST /ai/recommend). Without it the assistant
# reports itself unavailable; the simulation is unaffected.
OPENAI_API_KEY=

# Optional. Defaults to the model in ai/planner.py.
# OPENAI_MODEL=
