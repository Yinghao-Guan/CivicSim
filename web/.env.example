# CivicSim frontend flags. Copy to .env.local to use; .env.local is gitignored.
#
#   cp .env.example .env.local          # macOS / Linux / Git Bash
#   Copy-Item .env.example .env.local   # Windows PowerShell
#
# Next.js reads .env.local automatically. Restart the dev server after editing:
# NEXT_PUBLIC_* values are inlined at build time, not read at runtime.

# Serve the basemap from web/public/offline instead of the network.
# Insurance against venue Wi-Fi (doc 03 §2.3.2). Layers 2 and 3 are already
# local, so with this on the whole demo runs offline.
# Build the package first: python scripts/build_offline_tiles.py
NEXT_PUBLIC_OFFLINE_TILES=off

# Cap on MapLibre's pixelRatio. Drop to 1.5 if pitched views stutter on a
# high-DPI external display (doc 03 §4.3).
NEXT_PUBLIC_MAX_PIXEL_RATIO=2

# Hide the M4 occlusion probe (the cyan line and dots crossing the slice).
# Set to "off" once real simulation layers make it redundant.
NEXT_PUBLIC_OCCLUSION_PROBE=on

# The FastAPI simulation backend, once it exists (doc 02 §10).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
